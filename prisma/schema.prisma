datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum ListingStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(CUSTOMER)
  fullName     String
  phone        String?
  whatsapp     String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  products     Product[]     @relation("VendorProducts")
  stays        Stay[]        @relation("HostStays")
  orders       Order[]       @relation("CustomerOrders")
  bookings     Booking[]     @relation("CustomerBookings")
  sentMessages Message[]     @relation("SentMessages")
}

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String
  price        Float
  currency     String        @default("AUD")
  category     String
  originIsland String
  material     String?
  stock        Int           @default(0)
  status       ListingStatus @default(PENDING)
  images       String[]      // Array of image URLs
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  vendorId     String
  vendor       User          @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)
}

model Stay {
  id            String        @id @default(uuid())
  name          String
  description   String
  pricePerNight Float
  currency      String        @default("AUD")
  type          String        // e.g. "homestay", "eco-lodge", "villa"
  location      String        // e.g. "Bikenibeu", "London"
  island        String        // e.g. "Tarawa", "Kiritimati"
  maxGuests     Int           @default(2)
  bedrooms      Int           @default(1)
  beds          Int           @default(1)
  bathrooms     Int           @default(1)
  amenities     String[]      // e.g. ["WiFi", "Breakfast"]
  status        ListingStatus @default(PENDING)
  images        String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  hostId        String
  host          User          @relation("HostStays", fields: [hostId], references: [id], onDelete: Cascade)
  bookings      Booking[]
}

model Order {
  id             String      @id @default(uuid())
  total          Float
  subtotal       Float
  deliveryFee    Float       @default(15.0)
  tax            Float
  currency       String      @default("AUD")
  status         OrderStatus @default(PENDING)
  shippingAddress Json       // JSON representation of Address
  trackingNumber String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  userId         String
  user           User        @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  productId String
  name      String
  price     Float
  quantity  Int
  image     String?

  // Relations
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String        @id @default(uuid())
  checkIn     DateTime
  checkOut    DateTime
  guestCount  Int           @default(1)
  status      BookingStatus @default(PENDING)
  message     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  userId      String
  user        User          @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Cascade)
  stayId      String
  stay        Stay          @relation(fields: [stayId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(uuid())
  targetId     String   // Maps to product.id or stay.id
  targetType   String   // "product" or "stay"
  rating       Int      // 1 to 5 stars
  reviewerName String
  comment      String
  createdAt    DateTime @default(now())
}

model Conversation {
  id                String    @id @default(uuid())
  participantNames  String[]
  lastMessage       String?
  lastMessageTime   DateTime  @default(now())
  unread            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  messages          Message[]
}

model Message {
  id             String       @id @default(uuid())
  text           String
  timestamp      DateTime     @default(now())

  // Relations
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}
